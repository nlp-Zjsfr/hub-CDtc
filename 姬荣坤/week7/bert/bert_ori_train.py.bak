import os
import json
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from transformers import BertTokenizerFast, BertForTokenClassification
from torch.optim import AdamW
from tqdm import tqdm
import random
import numpy as np

# ================= 配置 =================
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
MAX_LEN = 512
BATCH_SIZE = 16
EPOCHS = 10
LR = 2e-5

def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

def build_tag_dicts(train_path):
    roles, triggers = set(), set()
    with open(train_path, 'r', encoding='utf-8') as f:
        for line in f:
            if not line.strip(): continue
            item = json.loads(line)
            event = item.get("event")
            if event:
                if event.get("trigger", {}).get("text"):
                    triggers.add("Trigger")
                for arg in event.get("args", []):
                    if arg.get("role"):
                        roles.add(arg["role"])
    
    # 只构建 B- 标签，不使用 I- 标签，后续 token 统一给 -100
    tag2id = {"O": 0}
    for t in triggers.union(roles):
        tag2id[f"B-{t}"] = len(tag2id)
    id2tag = {v: k for k, v in tag2id.items()}
    return tag2id, id2tag

class EventDataset(Dataset):
    def __init__(self, path, tokenizer, tag2id):
        self.data = []
        with open(path, 'r', encoding='utf-8') as f:
            for line in f:
                if not line.strip(): continue
                item = json.loads(line)
                text = item.get("text", "")
                if not text: continue
                
                # 使用 Fast Tokenizer 获取偏移量
                encoding = tokenizer(
                    text, 
                    max_length=MAX_LEN, 
                    truncation=True, 
                    padding="max_length", 
                    return_offsets_mapping=True
                )
                
                input_ids = encoding["input_ids"]
                attention_mask = encoding["attention_mask"]
                offset_mapping = encoding["offset_mapping"]
                
                # 初始化标签为 -100 (忽略)
                labels = [-100] * len(input_ids)
                
                # 先把所有非特殊字符（[CLS], [SEP], [PAD]）的标签设为 'O'
                for i, offset in enumerate(offset_mapping):
                    if offset != (0, 0): # 非特殊 token
                        if attention_mask[i] == 1:
                            labels[i] = tag2id["O"]
                
                event = item.get("event")
                if event:
                    # 填写 Trigger
                    trig = event.get("trigger")
                    if trig and trig.get("start") is not None:
                        self._fill_label(labels, offset_mapping, trig["start"], trig["end"], "Trigger", tag2id)
                    
                    # 填写 Args
                    for arg in event.get("args", []):
                        role = arg.get("role")
                        if role and arg.get("start") is not None:
                            self._fill_label(labels, offset_mapping, arg["start"], arg["end"], role, tag2id)
                            
                self.data.append({
                    "input_ids": torch.tensor(input_ids),
                    "attention_mask": torch.tensor(attention_mask),
                    "labels": torch.tensor(labels),
                    "offset_mapping": offset_mapping, # 验证时也可用
                    "orig_text": text
                })

    def _fill_label(self, labels, offset_mapping, start, end, role, tag2id):
        """根据实体的起始位置，只给第一个 token 标 B-XXX，其余覆盖的 token 保持 -100"""
        is_first_token = True
        for i, (tok_start, tok_end) in enumerate(offset_mapping):
            if tok_start == tok_end: continue # 特殊字符
            
            # 如果 token 在实体的 [start, end) 范围内重叠
            if tok_start < end and tok_end > start:
                if is_first_token:
                    labels[i] = tag2id[f"B-{role}"]
                    is_first_token = False
                else:
                    labels[i] = -100 # 后面的 token 不参与 Loss 计算

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        return self.data[idx]

def main():
    set_seed(42)
    script_dir = os.path.dirname(os.path.abspath(__file__))
    root_dir = os.path.dirname(script_dir)
    
    train_path = os.path.join(root_dir, "data", "processed", "train_extract.jsonl")
    model_path = os.path.join(root_dir, "bert", "bert-base-chinese")
    save_dir = os.path.join(root_dir, "output", "bert_ori")
    os.makedirs(save_dir, exist_ok=True)
    
    print(f"✅ 当前使用的设备: {DEVICE}")
    print("1. 初始化字典与数据集...")
    tag2id, id2tag = build_tag_dicts(train_path)
    tokenizer = BertTokenizerFast.from_pretrained(model_path)
    
    dataset = EventDataset(train_path, tokenizer, tag2id)
    dataloader = DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=True)
    
    print("2. 加载预训练模型...")
    model = BertForTokenClassification.from_pretrained(
        model_path, 
        num_labels=len(tag2id), 
        id2label=id2tag, 
        label2id=tag2id
    ).to(DEVICE)
    
    optimizer = AdamW(model.parameters(), lr=LR)
    
    # 记录最低训练 Loss
    best_train_loss = float('inf')
    
    print("3. 开始训练...")
    for epoch in range(EPOCHS):
        model.train()
        total_loss = 0
        pbar = tqdm(dataloader, desc=f"Epoch {epoch+1}/{EPOCHS}")
        
        for batch in pbar:
            input_ids = batch["input_ids"].to(DEVICE)
            attention_mask = batch["attention_mask"].to(DEVICE)
            labels = batch["labels"].to(DEVICE)
            
            optimizer.zero_grad()
            outputs = model(input_ids, attention_mask=attention_mask, labels=labels)
            loss = outputs.loss
            loss.backward()
            optimizer.step()
            
            total_loss += loss.item()
            pbar.set_postfix(loss=f"{loss.item():.4f}")
            
        epoch_loss = total_loss / len(dataloader)
        print(f" [Epoch {epoch+1}] 平均训练 Loss: {epoch_loss:.4f}")
        
        # 保存 Loss 最低的模型
        if epoch_loss < best_train_loss:
            best_train_loss = epoch_loss
            print(f" 🌟 发现更低 Loss ({best_train_loss:.4f})，保存模型...")
            model.save_pretrained(save_dir)
            tokenizer.save_pretrained(save_dir)
            # 保存字典以备验证
            with open(os.path.join(save_dir, "tag_dict.json"), "w", encoding="utf-8") as f:
                json.dump({"tag2id": tag2id, "id2tag": id2tag}, f, ensure_ascii=False)

    print(f"✅ 训练完成！最优模型已保存至 {save_dir}")

if __name__ == "__main__":
    main()